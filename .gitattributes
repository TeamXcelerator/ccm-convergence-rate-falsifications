# Treat the canonical reference data as binary so its SHA-256 hash is
# stable across platforms. Without this, Windows clients with autocrlf
# would change LF to CRLF on checkout and break hash verification.
data/*.json -text
*.pdf binary

# Shell scripts must be checked out with LF line endings, even on Windows,
# so they execute correctly on Linux (Vast) without "bad interpreter" errors.
*.sh text eol=lf

# Rust / TOML / Markdown / lock files — let git auto-handle.
*.rs text
*.toml text
*.md text
*.lock text
