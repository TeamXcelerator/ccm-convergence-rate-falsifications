*.pdf binary

# Shell scripts must be checked out with LF line endings, even on Windows,
# so they execute correctly on Linux (Vast) without "bad interpreter" errors.
*.sh text eol=lf

# Rust / TOML / Markdown / lock files — let git auto-handle.
*.rs text
*.toml text
*.md text
*.lock text

# Keep documentation, validation records and Python tools portable.
*.py text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
README.md text eol=lf
docs/*.md text eol=lf
docs/validation/*.json text eol=lf
scripts/README.md text eol=lf
